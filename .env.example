
APP_NAME="Mus Luxury (LUXE)"
APP_ENV=production
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD
PUBLIC_STORE_URL=https://mus-luxury.com
PUBLIC_API_URL=https://api.mus-luxury.com/api/v1
CORS_ALLOWED_ORIGINS=https://mus-luxury.com,https://www.mus-luxury.com,https://api.mus-luxury.com,http://localhost:5173,http://localhost:1420,tauri://localhost

# ----------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECURITY & AUTHENTICATION TOKENS
# Generate new 64-byte secrets with: openssl rand -hex 64
# ----------------------------------------------------------------------------
SECRET_KEY=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64>
CMS_HMAC_SIGNING_SECRET=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64>
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_LOGIN_ATTEMPTS_PER_MINUTE=5
SIGNATURE_MAX_SKEW_SECONDS=300

# ----------------------------------------------------------------------------
# 3. DATABASE CREDENTIALS (POSTGRESQL 16 PRODUCTION & SQLITE LOCAL/DEV)
# ----------------------------------------------------------------------------
LUXE_DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=luxe_ecommerce
POSTGRES_USER=luxe_app_user
POSTGRES_PASSWORD=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32>
DATABASE_URL=postgresql://luxe_app_user:<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32>@db:5432/luxe_ecommerce

# Local / Test SQLite Database Path (Used when LUXE_DB_ENGINE=sqlite outside Docker)
LUXE_SQLITE_PATH=./backend/luxe_store.sqlite3

# ----------------------------------------------------------------------------
# 4. INITIAL SEEDED CMS ADMINISTRATOR CREDENTIALS (DEV/TEST ONLY — IGNORED IN PROD)
# In production (APP_ENV=production), no default admin accounts are seeded;
# use the First-Time Owner Setup Wizard (/api/v1/admin/auth/initialize-owner)
# or the server-side CLI (backend/scripts/emergency_reset_owner.py).
# ----------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@mus-luxury.com
ADMIN_INITIAL_PASSWORD=<CHANGE_ME_STRONG_DEV_PASSWORD>
ADMIN_INITIAL_FULL_NAME="Mustapha Harbit (Owner)"
ADMIN_SECONDARY_PHONE=+213559420426
ADMIN_EMERGENCY_RECOVERY_CODE=<CHANGE_ME_DEV_RECOVERY_CODE>

EDITOR_INITIAL_EMAIL=editor@mus-luxury.com
EDITOR_INITIAL_PASSWORD=<CHANGE_ME_STRONG_DEV_PASSWORD>
EDITOR_INITIAL_PHONE=+213559420426

# ----------------------------------------------------------------------------
# 5. OFFICIAL META WHATSAPP BUSINESS CLOUD API (OPTIONAL ALERTS & CONCIERGE)
# Obtain from https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
# Password recovery via WhatsApp is intentionally disabled for security;
# recovery is strictly CLI-driven on the VPS via emergency_reset_owner.py.
# ----------------------------------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN=<CHANGE_ME_META_WHATSAPP_SYSTEM_USER_TOKEN>
WHATSAPP_ACCESS_TOKEN=<CHANGE_ME_META_WHATSAPP_SYSTEM_USER_TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<CHANGE_ME_META_PHONE_NUMBER_ID>
WHATSAPP_BUSINESS_ACCOUNT_ID=<CHANGE_ME_META_BUSINESS_ACCOUNT_ID>
WHATSAPP_APP_ID=<CHANGE_ME_META_APP_ID>
WHATSAPP_APP_SECRET=<CHANGE_ME_META_APP_SECRET_FOR_WEBHOOK_HMAC>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<CHANGE_ME_META_WEBHOOK_VERIFY_TOKEN>
WHATSAPP_API_VERSION=v20.0
WHATSAPP_SANDBOX_MODE=false
WHATSAPP_TEST_CAPTURE=0
STORE_WHATSAPP_CONTACT_NUMBER=+213655534154

# ----------------------------------------------------------------------------
# 6. ALGERIAN DELIVERY & COURIER API TOKENS (OPTIONAL — 69 WILAYAS SYNC)
# ----------------------------------------------------------------------------
DELIVERY_DEFAULT_PROVIDER=manual_cms
YALIDINE_API_ID=<CHANGE_ME_YALIDINE_API_ID>
YALIDINE_API_TOKEN=<CHANGE_ME_YALIDINE_API_TOKEN>
YALIDINE_API_BASE_URL=https://api.yalidine.app/v1

ZR_EXPRESS_API_KEY=<CHANGE_ME_ZREXPRESS_API_KEY>
ZR_EXPRESS_TOKEN=<CHANGE_ME_ZREXPRESS_TOKEN>
ZR_EXPRESS_BASE_URL=https://procolis.com/api_v1

MAYSTRO_API_TOKEN=<CHANGE_ME_MAYSTRO_API_TOKEN>
MAYSTRO_STORE_ID=<CHANGE_ME_MAYSTRO_STORE_ID>

# ----------------------------------------------------------------------------
# 7. PAYMENT GATEWAY & MARKETING PIXEL TOKENS (OPTIONAL — COD IS DEFAULT)
# ----------------------------------------------------------------------------
PAYMENT_DEFAULT_METHOD=cod
CHARGILY_MODE=test
CHARGILY_PUBLIC_KEY=<CHANGE_ME_CHARGILY_PUBLIC_KEY>
CHARGILY_SECRET_KEY=<CHANGE_ME_CHARGILY_SECRET_KEY>
CHARGILY_WEBHOOK_SECRET=<CHANGE_ME_CHARGILY_WEBHOOK_SECRET>

META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------------------
# 8. STORAGE, AUTOMATED BACKUPS & OFFSITE S3 / MINIO ARCHIVAL
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/lib/luxe/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

BACKUP_DIR=/var/lib/luxe/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE="30 2 * * *"
BACKUP_ENCRYPTION_KEY=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32>

S3_BACKUP_ENABLED=false
S3_ENDPOINT_URL=https://s3.eu-west-3.amazonaws.com
S3_REGION=eu-west-3
S3_BUCKET_NAME=mus-luxury-backups
S3_ACCESS_KEY_ID=<CHANGE_ME_S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<CHANGE_ME_S3_SECRET_ACCESS_KEY>

# ----------------------------------------------------------------------------
# 9. SMTP EMAIL NOTIFICATIONS (OPTIONAL)
# ----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@mus-luxury.com
SMTP_PASSWORD=<CHANGE_ME_SMTP_APP_PASSWORD>
SMTP_FROM_EMAIL="Mus Luxury <contact@mus-luxury.com>"

# ----------------------------------------------------------------------------
# 10. FRONTEND STOREFRONT & TAURI 2 DESKTOP CMS BUILD VARIABLES (VITE_*)
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CMS_API_URL=http://localhost:8000/api/v1
VITE_STORE_WHATSAPP_NUMBER=+213655534154
VITE_ENABLE_REQUEST_SIGNING=true
