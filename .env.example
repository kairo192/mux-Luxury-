# ============================================================================
# MUS LUXURY (LUXE) E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# Copy to .env and replace placeholder values before deploying to production.
# NEVER commit your actual .env file to Git.
# ============================================================================

# Application
APP_NAME="Mus Luxury (LUXE)"
APP_ENV=production
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD

# Security (Generate with: openssl rand -hex 64)
SECRET_KEY=replace_with_64_byte_cryptographic_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ALLOWED_ORIGINS=https://musluxury.dz,https://www.musluxury.dz,tauri://localhost

# Database (PostgreSQL 16 in production; SQLite fallback for local/CI testing)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=luxe_ecommerce
POSTGRES_USER=luxe_app_user
POSTGRES_PASSWORD=replace_with_strong_random_db_password
DATABASE_URL=postgresql+psycopg://luxe_app_user:replace_with_strong_random_db_password@db:5432/luxe_ecommerce

# Official WhatsApp Business Cloud API (Optional — Leave blank to use Offline Emergency Code)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Storage & Backups
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/lib/luxe/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
BACKUP_DIR=/var/lib/luxe/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE="30 2 * * *"
