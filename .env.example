# ----------------------------------------------------------------------------
SECRET_KEY=8f4e9c2a1b7d6e5f3a9c8b7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f
CMS_HMAC_SIGNING_SECRET=5a7c9e1f3b5d7f9a2c4e6a8b0d2f4a6c8e0b2d4f6a8c0e2f4a6b8d0e2f4a6c8e
