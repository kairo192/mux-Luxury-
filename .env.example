# ============================================================================
# MUS LUXURY (LUXE) E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# Copy to .env and replace placeholder values before deploying to production.
# NEVER commit your actual .env file to Git.
# ============================================================================

# Application
APP_NAME="Mus Luxury (LUXE)"
APP_ENV=development
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_64_char_cryptographic_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_INITIAL_EMAIL=admin@musluxury.dz
ADMIN_INITIAL_PASSWORD=ChangeMe_MusLuxury_2026!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,https://musluxury.dz

# Database (PostgreSQL in production; SQLite fallback for cloud sandbox testing)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=luxe_ecommerce
POSTGRES_USER=luxe_app_user
POSTGRES_PASSWORD=replace_with_strong_db_password
DATABASE_URL=postgresql+psycopg://luxe_app_user:replace_with_strong_db_password@db:5432/luxe_ecommerce

# Storage & Backups
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/lib/luxe/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
BACKUP_DIR=/var/lib/luxe/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE="0 3 * * *"
