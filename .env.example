# =============================================================================
# Mus Luxury — .env template (production). GENERATED from backend/app/settings.py:
# do not edit by hand — change the list there, then run (from backend/):
#   python3 -m app.settings templates
# Real values: python3 backend/scripts/generate_production_env.py (fresh secrets)
# Check a filled file: python3 -m app.settings check <file>
# Empty value = feature off.  <CHANGE_ME_…> = must be generated before use.
# =============================================================================

# --- Shop and domain ---------------------------------------------------------
# production on the VPS; development/test elsewhere (demo data, docs, relaxed checks). [REQUIRED in production]
APP_ENV=production
# Public address of the shop (links in Google, sitemap, shared links). [REQUIRED in production]
PUBLIC_STORE_URL=https://mus-luxury.com
# Extra web addresses allowed to call the API, comma-separated (mus-luxury.com, www and api are always allowed).
CORS_ORIGINS=
# Shop clock for daily reports and receipts.
SHOP_TIMEZONE=Africa/Algiers
# 1 = show /docs in production (off by default).
ENABLE_API_DOCS=0

# --- Security (generated — keep secret) --------------------------------------
# Signs logins. 64+ random hex characters; the server refuses to start without it. [REQUIRED in production]
SECRET_KEY=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64>
# Signs requests from the desktop CMS. Different from SECRET_KEY. [REQUIRED in production]
CMS_HMAC_SIGNING_SECRET=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64>
# How long a CMS login stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=240
# Wrong passwords allowed per minute and address (1–30).
LOGIN_ATTEMPTS_PER_MINUTE=5

# --- Database ----------------------------------------------------------------
# postgres on the VPS; sqlite for a single PC. [REQUIRED in production]
LUXE_DB_ENGINE=postgres
# PostgreSQL host (the Docker service).
POSTGRES_HOST=db
# PostgreSQL port.
POSTGRES_PORT=5432
# Database name.
POSTGRES_DB=luxe_ecommerce
# Database user.
POSTGRES_USER=luxe_app_user
# Database password (generated). [REQUIRED in production]
POSTGRES_PASSWORD=<CHANGE_ME_POSTGRES_PASSWORD>
# Full connection address (contains the password). [REQUIRED in production]
DATABASE_URL=postgresql://luxe_app_user:<CHANGE_ME_POSTGRES_PASSWORD>@db:5432/luxe_ecommerce

# --- First start (owner account) ---------------------------------------------
# 1 = create the owner account at first start (production: only with a strong ADMIN_INITIAL_PASSWORD). 0 = the owner uses the first-time setup screen.
LUXE_SEED_DEMO_ACCOUNTS=0
# 1 = example products (never in production).
LUXE_SEED_DEMO_PRODUCTS=0
# Owner e-mail when the account is created at first start.
ADMIN_INITIAL_EMAIL=
# Owner name when the account is created at first start.
ADMIN_INITIAL_FULL_NAME=Propriétaire
# Owner password when the account is created at first start (12+ characters). Change it after the first login.
ADMIN_INITIAL_PASSWORD=

# --- Photos and backups ------------------------------------------------------
# Product photos.
UPLOAD_DIR=/var/lib/luxe/uploads
# Encrypted backups.
BACKUP_DIR=/var/lib/luxe/backups
# Encrypts every backup. Keep a copy in a password manager: without it no backup can be restored. [REQUIRED in production]
BACKUP_ENCRYPTION_KEY=<CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32>
# Days database backups are kept.
BACKUP_RETENTION_DAYS=30
# When the nightly backup runs (cron format).
BACKUP_CRON_SCHEDULE=30 3 * * *
# Photo archives kept (only made when photos change).
BACKUP_MEDIA_KEEP=3
# Under this % of free disk, photo archives are skipped.
BACKUP_MIN_FREE_PCT=15
# Optional Uptime Kuma push URL, called only after a night where backup, off-site copy and verification all succeeded (Kuma alerts when it stops).
BACKUP_HEARTBEAT_URL=

# --- Off-site backup copy (S3-compatible storage) ----------------------------
# true = copy each night's backup to S3-compatible storage (strongly recommended: the VPS can be lost).
S3_BACKUP_ENABLED=false
# Storage address. Free 10 GB: Backblaze B2 (https://s3.<region>.backblazeb2.com) or Cloudflare R2 (https://<account-id>.r2.cloudflarestorage.com).
S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
# Storage region (Backblaze: in the endpoint, e.g. eu-central-003; R2: auto).
S3_REGION=eu-central-003
# Bucket name.
S3_BUCKET_NAME=mus-luxury-backups
# Folder inside the bucket.
S3_BUCKET_PREFIX=luxe
# Storage access key.
S3_ACCESS_KEY_ID=
# Storage secret key.
S3_SECRET_ACCESS_KEY=
# Days off-site database copies are kept (older ones are deleted there; the newest BACKUP_MEDIA_KEEP photo archives are always kept).
OFFSITE_RETENTION_DAYS=30

# --- WhatsApp Cloud API webhook (optional) -----------------------------------
# Webhook check (Meta app settings). Empty = webhook off. Messages to customers need no key (staff send prepared wa.me messages).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret: checks webhook signatures.
WHATSAPP_APP_SECRET=

# --- Desktop CMS / till versions ---------------------------------------------
# Oldest desktop CMS version allowed to connect.
POS_MIN_SUPPORTED_VERSION=1.0.0
# Newest desktop CMS version (shown as an update).
POS_LATEST_VERSION=1.0.0
# API contract version the CMS checks.
POS_API_CONTRACT_VERSION=1
