# and logs dispatches to backend/backups/whatsapp_outbox.jsonl.
# Set WHATSAPP_SANDBOX_MODE=false once your live Meta token & Phone ID are pasted.
# ----------------------------------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN=EAATest_Replace_With_Your_Meta_WhatsApp_Permanent_System_User_Token
WHATSAPP_ACCESS_TOKEN=EAATest_Replace_With_Your_Meta_WhatsApp_Permanent_System_User_Token
WHATSAPP_PHONE_NUMBER_ID=109283746519283
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_APP_ID=123456789012345
WHATSAPP_APP_SECRET=replace_with_meta_app_secret_for_webhook_hmac_verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mus_luxury_wa_webhook_verify_2026_secret
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=luxe_admin_password_reset
WHATSAPP_TEMPLATE_LANG=fr
WHATSAPP_SANDBOX_MODE=true
WHATSAPP_TEST_CAPTURE=0
STORE_WHATSAPP_CONTACT_NUMBER=+213655534154

# ----------------------------------------------------------------------------
# 6. ALGERIAN DELIVERY & COURIER API TOKENS (OPTIONAL — 69 WILAYAS SYNC)
# Supported couriers: Yalidine Express, ZR Express, Maystro Delivery, Procolis
# ----------------------------------------------------------------------------
DELIVERY_DEFAULT_PROVIDER=manual_cms
YALIDINE_API_ID=your_yalidine_api_id_here
YALIDINE_API_TOKEN=your_yalidine_api_token_here
YALIDINE_API_BASE_URL=https://api.yalidine.app/v1

ZR_EXPRESS_API_KEY=your_zrexpress_api_key_here
ZR_EXPRESS_TOKEN=your_zrexpress_token_here
ZR_EXPRESS_BASE_URL=https://procolis.com/api_v1

MAYSTRO_API_TOKEN=your_maystro_api_token_here
MAYSTRO_STORE_ID=your_maystro_store_id_here

# ----------------------------------------------------------------------------
# 7. PAYMENT GATEWAY & MARKETING PIXEL TOKENS (OPTIONAL — COD IS DEFAULT)
# ----------------------------------------------------------------------------
PAYMENT_DEFAULT_METHOD=cod
CHARGILY_MODE=test
CHARGILY_PUBLIC_KEY=test_pk_replace_with_chargily_edahabia_cib_public_key
CHARGILY_SECRET_KEY=test_sk_replace_with_chargily_edahabia_cib_secret_key
CHARGILY_WEBHOOK_SECRET=replace_with_chargily_webhook_secret

META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------------------
# 8. STORAGE, AUTOMATED BACKUPS & OFFSITE S3 / MINIO ARCHIVAL
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/lib/luxe/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

BACKUP_DIR=/var/lib/luxe/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE="30 2 * * *"
BACKUP_ENCRYPTION_KEY=7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e

S3_BACKUP_ENABLED=false
S3_ENDPOINT_URL=https://s3.eu-west-3.amazonaws.com
S3_REGION=eu-west-3
S3_BUCKET_NAME=mus-luxury-backups
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# ----------------------------------------------------------------------------
# 9. SMTP EMAIL NOTIFICATIONS (OPTIONAL)
# ----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@musluxury.dz
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL="Mus Luxury <contact@musluxury.dz>"

