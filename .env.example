# ----------------------------------------------------------------------------
# 1. APPLICATION & CORE URLS
# ----------------------------------------------------------------------------
APP_NAME="Mus Luxury (LUXE)"
APP_ENV=production
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD
PUBLIC_STORE_URL=https://musluxury.dz
PUBLIC_API_URL=https://api.musluxury.dz/api/v1
CORS_ALLOWED_ORIGINS=https://musluxury.dz,https://www.musluxury.dz,http://localhost:5173,http://localhost:1420,tauri://localhost

# ----------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECURITY & AUTHENTICATION TOKENS
