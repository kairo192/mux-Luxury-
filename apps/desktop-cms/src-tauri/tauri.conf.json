{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mus Luxury CMS",
  "version": "1.0.0",
  "identifier": "com.musluxury.cms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mus Luxury (LUXE) — Administration & Inventaire",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.mus-luxury.com https://mus-luxury.com http://localhost:8000 http://127.0.0.1:8000 ipc: http://ipc.localhost; img-src 'self' data: blob: http://localhost:5173 https://api.mus-luxury.com https://mus-luxury.com http://localhost:8000 http://127.0.0.1:8000; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Kirodev",
    "shortDescription": "Mus Luxury — CMS & caisse",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    },
    "copyright": "© 2026 Kirodev"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.mus-luxury.com/api/v1/admin/updates/cms/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
