# -----------------------------------------------------------------------------
# PRODUCTION environment template.
# Lives on the production VPS at /opt/luxe/shared/.env ONLY:
#     chmod 0600 /opt/luxe/shared/.env
#     chown luxe:luxe /opt/luxe/shared/.env
#
# NEVER commit a filled-in copy. Secrets are managed:
#   - GitHub Actions Secrets          → used during build / deploy only
#   - /opt/luxe/shared/.env on the VPS → used at runtime by docker-compose
# The two sets are kept intentionally separate; nothing on GitHub needs the
# runtime secrets, and nothing on the VPS needs the deploy secrets.
# -----------------------------------------------------------------------------
APP_NAME="Mus Luxury (LUXE)"
APP_ENV=production
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD
PUBLIC_STORE_URL=https://mus-luxury.com
PUBLIC_API_URL=https://api.mus-luxury.com/api/v1
CORS_ALLOWED_ORIGINS=https://mus-luxury.com,https://www.mus-luxury.com,https://api.mus-luxury.com,tauri://localhost

# openssl rand -hex 64  — PRODUCTION values, NEVER shared with staging or dev.
SECRET_KEY=REPLACE_production_secret_openssl_rand_hex_64
CMS_HMAC_SIGNING_SECRET=REPLACE_production_hmac_openssl_rand_hex_64
ACCESS_TOKEN_EXPIRE_MINUTES=240
MAX_LOGIN_ATTEMPTS_PER_MINUTE=5
SIGNATURE_MAX_SKEW_SECONDS=300

LUXE_DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=luxe_ecommerce
POSTGRES_USER=luxe_app_user
POSTGRES_PASSWORD=REPLACE_production_postgres_password
DATABASE_URL=postgresql://luxe_app_user:REPLACE_production_postgres_password@db:5432/luxe_ecommerce

# With APP_ENV=production the backend REFUSES to seed default admins. Use
# the Owner Setup Wizard once (POST /api/v1/admin/auth/initialize-owner).
# These two variables exist only so the compose file does not fail to parse.
ADMIN_INITIAL_EMAIL=disabled-in-production
ADMIN_INITIAL_PASSWORD=disabled-in-production
ADMIN_INITIAL_FULL_NAME="Mustapha Harbit (Owner)"
ADMIN_SECONDARY_PHONE=+213559420426
ADMIN_EMERGENCY_RECOVERY_CODE=REPLACE_production_recovery_openssl_rand_hex_16

# Real WhatsApp Business Cloud API tokens go here (Concierge / Alerts).
# Password reset over WhatsApp is disabled for security; CLI recovery on VPS is used.
WHATSAPP_SANDBOX_MODE=false
WHATSAPP_CLOUD_API_TOKEN=REPLACE_production_wa_system_user_token
WHATSAPP_ACCESS_TOKEN=REPLACE_production_wa_system_user_token
WHATSAPP_PHONE_NUMBER_ID=REPLACE_production_wa_phone_id
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_production_wa_biz_id
WHATSAPP_APP_ID=REPLACE_production_wa_app_id
WHATSAPP_APP_SECRET=REPLACE_production_wa_app_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_production_wa_verify_token
WHATSAPP_API_VERSION=v20.0
STORE_WHATSAPP_CONTACT_NUMBER=+213655534154

# Delivery & payment — fill in when the account is live.
DELIVERY_DEFAULT_PROVIDER=manual_cms
YALIDINE_API_ID=REPLACE_production_yalidine_id
YALIDINE_API_TOKEN=REPLACE_production_yalidine_token
YALIDINE_API_BASE_URL=https://api.yalidine.app/v1

PAYMENT_DEFAULT_METHOD=cod
CHARGILY_MODE=live
CHARGILY_PUBLIC_KEY=REPLACE_production_chargily_public
CHARGILY_SECRET_KEY=REPLACE_production_chargily_secret
CHARGILY_WEBHOOK_SECRET=REPLACE_production_chargily_webhook_secret

# Local storage + nightly off-site encrypted backup (S3-compatible endpoint).
STORAGE_PROVIDER=local
UPLOAD_DIR=/var/lib/luxe/uploads
MAX_UPLOAD_SIZE_MB=5
BACKUP_DIR=/var/lib/luxe/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON_SCHEDULE="30 3 * * *"
BACKUP_ENCRYPTION_KEY=REPLACE_production_backup_encryption_openssl_rand_hex_32

S3_BACKUP_ENABLED=true
S3_ENDPOINT_URL=https://s3.eu-west-3.amazonaws.com
S3_REGION=eu-west-3
S3_BUCKET_NAME=mus-luxury-backups
S3_ACCESS_KEY_ID=REPLACE_production_s3_access_key
S3_SECRET_ACCESS_KEY=REPLACE_production_s3_secret_key

SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@mus-luxury.com
SMTP_PASSWORD=REPLACE_production_smtp_app_password
SMTP_FROM_EMAIL="Mus Luxury <contact@mus-luxury.com>"

VITE_API_BASE_URL=https://api.mus-luxury.com/api/v1
VITE_CMS_API_URL=https://api.mus-luxury.com/api/v1
VITE_STORE_WHATSAPP_NUMBER=+213655534154
VITE_ENABLE_REQUEST_SIGNING=true

POS_MIN_SUPPORTED_VERSION=1.0.0
POS_LATEST_VERSION=1.0.0
POS_API_CONTRACT_VERSION=1
