# -----------------------------------------------------------------------------
# STAGING environment template.
# Lives on the staging VPS at /opt/luxe/shared/.env (chmod 0600, owner luxe).
# Staging MUST point at its OWN database — never at the production database,
# and never seeded with real customer or financial data.
# -----------------------------------------------------------------------------
APP_NAME="Mus Luxury (LUXE) — staging"
APP_ENV=staging
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD
PUBLIC_STORE_URL=https://staging.mus-luxury.com
PUBLIC_API_URL=https://staging-api.mus-luxury.com/api/v1
CORS_ALLOWED_ORIGINS=https://staging.mus-luxury.com,tauri://localhost

# Regenerate for staging with: openssl rand -hex 64
# Keep DIFFERENT from production.
SECRET_KEY=REPLACE_staging_secret_openssl_rand_hex_64
CMS_HMAC_SIGNING_SECRET=REPLACE_staging_hmac_openssl_rand_hex_64
ACCESS_TOKEN_EXPIRE_MINUTES=240
MAX_LOGIN_ATTEMPTS_PER_MINUTE=10
SIGNATURE_MAX_SKEW_SECONDS=300

LUXE_DB_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=luxe_staging
POSTGRES_USER=luxe_staging_user
POSTGRES_PASSWORD=REPLACE_staging_postgres_password
DATABASE_URL=postgresql://luxe_staging_user:REPLACE_staging_postgres_password@db:5432/luxe_staging

# In production APP_ENV blocks default-admin seeding. Staging keeps it enabled
# so a fresh staging box is usable without manual bootstrap. The seeded admin
# is safe only because staging never has real customer data.
ADMIN_INITIAL_EMAIL=admin+staging@mus-luxury.com
ADMIN_INITIAL_PASSWORD=REPLACE_staging_admin_password
ADMIN_INITIAL_FULL_NAME="Staging Owner"
ADMIN_SECONDARY_PHONE=+213000000000
STORE_WHATSAPP_CONTACT_NUMBER=+213655534154

DELIVERY_DEFAULT_PROVIDER=manual_cms
PAYMENT_DEFAULT_METHOD=cod
CHARGILY_MODE=test

STORAGE_PROVIDER=local
UPLOAD_DIR=/var/lib/luxe/uploads
MAX_UPLOAD_SIZE_MB=5
BACKUP_DIR=/var/lib/luxe/backups
BACKUP_RETENTION_DAYS=14
BACKUP_CRON_SCHEDULE="30 3 * * *"
BACKUP_ENCRYPTION_KEY=REPLACE_staging_backup_encryption_openssl_rand_hex_32

S3_BACKUP_ENABLED=false
SMTP_ENABLED=false

VITE_API_BASE_URL=https://staging-api.mus-luxury.com/api/v1
VITE_CMS_API_URL=https://staging-api.mus-luxury.com/api/v1
VITE_STORE_WHATSAPP_NUMBER=+213000000000
VITE_ENABLE_REQUEST_SIGNING=true

POS_MIN_SUPPORTED_VERSION=1.0.0
POS_LATEST_VERSION=1.0.0
POS_API_CONTRACT_VERSION=1
