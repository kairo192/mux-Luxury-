# -----------------------------------------------------------------------------
# DEVELOPMENT environment template.
# Copy to .env at the repo root, fill in, and run `docker compose up -d`.
# Suitable for localhost only; NEVER use these values on an internet-facing host.
# -----------------------------------------------------------------------------
APP_NAME="Mus Luxury (LUXE) — dev"
APP_ENV=development
# Shop time zone: "today", "this month" and report days follow it (times are stored in UTC).
SHOP_TIMEZONE=Africa/Algiers
API_V1_PREFIX=/api/v1
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES=fr,ar,en
PRIMARY_CURRENCY=DZD
PUBLIC_STORE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost

# Development secrets — regenerate once with `openssl rand -hex 64` and keep
# them out of git. Any value works locally; the real guard is that this file
# never leaves dev machines.
SECRET_KEY=REPLACE_dev_secret_openssl_rand_hex_64
CMS_HMAC_SIGNING_SECRET=REPLACE_dev_hmac_openssl_rand_hex_64
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_LOGIN_ATTEMPTS_PER_MINUTE=50
SIGNATURE_MAX_SKEW_SECONDS=300

# Use SQLite for fastest iteration; switch to postgres via docker-compose for
# integration work.
LUXE_DB_ENGINE=sqlite
LUXE_SQLITE_PATH=./backend/luxe_store.sqlite3

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=luxe_dev
POSTGRES_USER=luxe_dev_user
POSTGRES_PASSWORD=REPLACE_dev_postgres_password
DATABASE_URL=postgresql://luxe_dev_user:REPLACE_dev_postgres_password@db:5432/luxe_dev

# Dev-only bootstrap admin (production refuses to seed defaults).
ADMIN_INITIAL_EMAIL=admin@mus-luxury.com
ADMIN_INITIAL_PASSWORD=REPLACE_dev_admin_password
ADMIN_INITIAL_FULL_NAME="Dev Owner"
ADMIN_SECONDARY_PHONE=+213000000000
STORE_WHATSAPP_CONTACT_NUMBER=+213655534154

DELIVERY_DEFAULT_PROVIDER=manual_cms
PAYMENT_DEFAULT_METHOD=cod

STORAGE_PROVIDER=local
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_MB=5
BACKUP_DIR=./backend/backups
BACKUP_RETENTION_DAYS=7
BACKUP_CRON_SCHEDULE="30 2 * * *"
BACKUP_ENCRYPTION_KEY=REPLACE_dev_backup_encryption_openssl_rand_hex_32

S3_BACKUP_ENABLED=false
SMTP_ENABLED=false

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CMS_API_URL=http://localhost:8000/api/v1
VITE_STORE_WHATSAPP_NUMBER=+213000000000
VITE_ENABLE_REQUEST_SIGNING=false

POS_MIN_SUPPORTED_VERSION=1.0.0
POS_LATEST_VERSION=1.0.0
POS_API_CONTRACT_VERSION=1
